#!/usr/bin/env python3
import os
import sys

# Resolve real path of script in case it was invoked through a symlink
real_script = os.path.realpath(__file__)
lib = os.path.normpath(os.path.join(os.path.dirname(real_script), "..", "share", "sayri", "lib"))
if os.path.isdir(lib) and lib not in sys.path:
    sys.path.insert(0, lib)

from sayri.cli_pref import main

if __name__ == "__main__":
    sys.exit(main())
